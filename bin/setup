#!/usr/bin/env bash

# Install `uv` if it doesn't exist, and ensure the project's required Python version is installed (using `uv`).

info() { printf "\033[0;35m%s\033[0m\n" "${1}"; }
success() { printf "\033[0;32m✔︎\033[0m %s\n" "${1}"; }

check_for_uv() {
  if ! command -v uv >/dev/null; then
    info "Installing uv..."
    brew update && brew install uv
    success "Installed uv"
  fi
}

check_python_version() {
  REQUIRED_VERSION=$(head -n 1 ".python-version")
  uv python find "${REQUIRED_VERSION}" >/dev/null 2>&1 || uv python install --default
}

check_for_uv
check_python_version

success "Setup complete!"
